#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="${ANDROID_LAB_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADB_BIN="${ADB_BIN:-adb}"
SERIAL="${ANDROID_SERIAL:-}"
ADB_ARGS=()

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: android-lab [-s SERIAL] COMMAND [ARGS...]

Read-only commands:
  devices                         List ADB devices
  doctor [--json] [--for WORKFLOW] Check host/device readiness; works offline
                                  WORKFLOW: adb, frida, capture, apk
                                  --root opts into read-only su probes
  apk-inspect APK...|DIR           Inspect local APKs or a pull manifest offline
  logcat-dump PACKAGE [COUNT]      JSON tail of main logs for one PID (default 500)
  apps [TEXT]                     List third-party packages
  package-info PACKAGE            Show package metadata
  frida-status                    Show Frida version, process and listener
  frida-ps [ARGS...]              Run the pinned Frida process lister
  ui-dump                         Print the current UI hierarchy XML

Explicit actions:
  shell [COMMAND...]              Run an ADB shell or open an interactive one
  root-shell                      Open an interactive Magisk root shell
  root 'COMMAND'                  Run one explicit command as Magisk root
  logcat PACKAGE                  Stream logs for a running package
  pull-apk PACKAGE [DIR]          Pull all APK splits into artifacts/
  capture [DIR]                  Run USB mitmweb; restore proxy/mapping on exit
  screenshot [FILE]               Save the current screen into artifacts/
  input ARGS...                   Pass arguments to Android's input command
  open-url URL                    Open an HTTP(S) URL on the device
  proxy status
  proxy set HOST PORT             Set the Android global HTTP proxy
  proxy clear                     Clear the Android global HTTP proxy

Set ANDROID_SERIAL or use -s when more than one device is connected.
EOF
}

list_devices() {
  "$ADB_BIN" devices -l
}

select_device() {
  command -v "$ADB_BIN" >/dev/null 2>&1 || die "adb not found: $ADB_BIN"

  if [[ -n "$SERIAL" ]]; then
    [[ "$("$ADB_BIN" -s "$SERIAL" get-state 2>/dev/null || true)" == "device" ]] || \
      die "ADB device is not ready: $SERIAL"
  else
    local line state
    local -a devices=()
    while read -r line state _; do
      [[ "$state" == "device" ]] && devices+=("$line")
    done < <("$ADB_BIN" devices | tail -n +2)

    case "${#devices[@]}" in
      0) die "no authorized ADB device connected" ;;
      1) SERIAL="${devices[0]}" ;;
      *) die "multiple devices connected; use -s SERIAL or ANDROID_SERIAL" ;;
    esac
  fi

  ADB_ARGS=(-s "$SERIAL")
}

run_adb() {
  "$ADB_BIN" "${ADB_ARGS[@]}" "$@"
}

require_package() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._]+$ ]] || die "invalid Android package name: ${1:-<empty>}"
}

root_command() {
  [[ $# -eq 1 ]] || die "root requires one quoted command string"
  local escaped
  escaped="$(printf '%s' "$1" | sed "s/'/'\"'\"'/g")"
  run_adb shell "su -c '$escaped'"
}

frida_tool() {
  local tool="$1"
  shift
  local executable="$ROOT_DIR/.venv/bin/$tool"
  [[ -x "$executable" ]] || die "$tool is missing; create $ROOT_DIR/.venv and install the bundled requirements.txt"

  exec "${PYTHON:-python3}" "$SCRIPT_DIR/lab_session.py" --adb "$ADB_BIN" --serial "$SERIAL" \
    frida --port "${LAB_FRIDA_PORT:-27042}" -- "$executable" "$@"
}

COMMAND="${1:-help}"
if [[ "$COMMAND" == "-s" ]]; then
  [[ $# -ge 3 ]] || die "-s requires SERIAL and COMMAND"
  SERIAL="$2"
  shift 2
  COMMAND="$1"
fi
[[ $# -gt 0 ]] && shift

case "$COMMAND" in
  help|-h|--help)
    usage
    exit 0
    ;;
  devices)
    list_devices
    exit 0
    ;;
  doctor)
    exec "${PYTHON:-python3}" "$SCRIPT_DIR/doctor.py" --adb "$ADB_BIN" \
      --serial "$SERIAL" --root-dir "$ROOT_DIR" "$@"
    ;;
  apk-inspect)
    exec "${PYTHON:-python3}" "$SCRIPT_DIR/apk_inspect.py" "$@"
    ;;
  logcat-dump)
    [[ $# -ge 1 && $# -le 2 ]] || die "logcat-dump requires PACKAGE [COUNT]"
    require_package "$1"
    [[ "${2:-500}" =~ ^[1-9][0-9]{0,4}$ ]] && (( ${2:-500} <= 10000 )) || \
      die "count must be between 1 and 10000"
    ;;
esac

select_device

case "$COMMAND" in
  apps)
    if [[ $# -eq 0 ]]; then
      run_adb shell pm list packages -3 | sed 's/^package://'
    else
      run_adb shell pm list packages -3 | sed 's/^package://' | grep -iF -- "$1" || true
    fi
    ;;
  package-info)
    require_package "${1:-}"
    run_adb shell dumpsys package "$1"
    ;;
  frida-status)
    root_command 'if [ -x /data/adb/modules/magisk-frida/bin/frida-server ]; then /data/adb/modules/magisk-frida/bin/frida-server --version; else frida-server --version; fi; ps -A -o USER,PID,NAME,ARGS | grep -E "^[^ ]+[[:space:]]+[0-9]+[[:space:]]+frida-server[[:space:]]"; ss -lntp 2>/dev/null | grep 27042'
    ;;
  frida-ps)
    frida_tool frida-ps "$@"
    ;;
  ui-dump)
    run_adb shell uiautomator dump /dev/tty
    ;;
  shell)
    run_adb shell "$@"
    ;;
  root-shell)
    run_adb shell su
    ;;
  root)
    root_command "$@"
    ;;
  logcat)
    require_package "${1:-}"
    pid="$(run_adb shell pidof "$1" | tr -d '\r')"
    [[ -n "$pid" ]] || die "package is not running: $1"
    run_adb logcat --pid="$pid"
    ;;
  logcat-dump)
    exec "${PYTHON:-python3}" "$SCRIPT_DIR/logcat_dump.py" --adb "$ADB_BIN" \
      --serial "$SERIAL" "$@"
    ;;
  pull-apk)
    require_package "${1:-}"
    package="$1"
    output_dir="${2:-$ROOT_DIR/artifacts/apks/$package/$(date +%Y%m%d-%H%M%S)-$$}"
    exec "${PYTHON:-python3}" "$SCRIPT_DIR/pull_apk.py" --adb "$ADB_BIN" --serial "$SERIAL" \
      "$package" "$output_dir"
    ;;
  capture)
    output_dir="${1:-$ROOT_DIR/artifacts/mitm/$(date +%Y%m%d-%H%M%S)-$$}"
    exec "${PYTHON:-python3}" "$SCRIPT_DIR/lab_session.py" --adb "$ADB_BIN" --serial "$SERIAL" \
      capture "$output_dir"
    ;;
  screenshot)
    output_file="${1:-$ROOT_DIR/artifacts/screenshots/$(date +%Y%m%d-%H%M%S).png}"
    mkdir -p "$(dirname "$output_file")"
    run_adb exec-out screencap -p >"$output_file"
    printf '%s\n' "$output_file"
    ;;
  input)
    [[ $# -gt 0 ]] || die "input requires Android input arguments"
    run_adb shell input "$@"
    ;;
  open-url)
    [[ "${1:-}" =~ ^https?:// ]] || die "open-url only accepts HTTP(S) URLs"
    run_adb shell am start -a android.intent.action.VIEW -d "$1"
    ;;
  proxy)
    action="${1:-status}"
    case "$action" in
      status)
        run_adb shell settings get global http_proxy
        ;;
      set)
        host="${2:-}"
        port="${3:-}"
        [[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid proxy host"
        [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || die "invalid proxy port"
        run_adb shell settings put global http_proxy "$host:$port"
        printf 'proxy=%s:%s\n' "$host" "$port"
        ;;
      clear)
        run_adb shell settings put global http_proxy :0
        printf 'proxy=cleared\n'
        ;;
      *) die "unknown proxy action: $action" ;;
    esac
    ;;
  *)
    usage >&2
    die "unknown command: $COMMAND"
    ;;
esac
